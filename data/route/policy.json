{
  "version": 1,
  "disclaimer": "The router proposes an action and writes a draft. It never sends mail and never moves a file unless --apply is given. The costs below are ranked judgements about consequence, not measured losses, and the class shares are shares of evidence rather than calibrated probabilities.",
  "actions": [
    {
      "id": "reply",
      "note": "Answer the sender with a templated acknowledgement. The draft carries Auto-Submitted: auto-replied, so another robot reading it knows not to answer again.",
      "sends_mail": true
    },
    {
      "id": "forward",
      "note": "Send the message to the queue that owns the class. Refused for anything that must not leave the organisation, which is why the veto list exists.",
      "sends_mail": true
    },
    {
      "id": "file",
      "note": "Copy the message into the folder the policy names for its class and record why. The copy is additive, so the original is never destroyed by a wrong reading.",
      "sends_mail": false
    },
    {
      "id": "hold",
      "note": "Queue it for a person and do nothing else. This is the reject option: it is chosen when the reading is close to a boundary or a guard forbids every other action.",
      "sends_mail": false
    },
    {
      "id": "ignore",
      "note": "No action at all. Correct for bulk mail and lists, expensive for anything a person wrote.",
      "sends_mail": false
    }
  ],
